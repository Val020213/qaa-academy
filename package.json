{
  "name": "qaa-academy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Internal course: from manual QA to QA Automation with TypeScript and Playwright",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "shop:dev": "pnpm --filter practice-shop dev",
    "shop:e2e": "pnpm --filter practice-shop e2e",
    "shop:e2e:ui": "pnpm --filter practice-shop e2e:ui"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@playwright/test": "1.59.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.19.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "highlight.js": "^11.12.0",
    "lucide": "^1.52.0",
    "marked": "^18.0.14",
    "roughjs": "^4.6.6",
    "typescript": "5.9.3",
    "vite": "8.0.16"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.21.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  }
}
