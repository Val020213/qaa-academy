{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Every file is its own module, so two exercise files can use the same names.
    "moduleDetection": "force",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],

    // Strict mode: the type checker reports every type error it can find, such as a value that may be null.
    // It does not find logic errors: code with correct types can still do the wrong thing.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,

    // Only syntax that Node can run directly (`node file.ts`).
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,

    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },

    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "e2e", "exercises", "vite.config.ts", "playwright.config.ts"]
}
